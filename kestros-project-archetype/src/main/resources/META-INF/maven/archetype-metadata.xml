  <requiredProperties>
    <requiredProperty key="artifactDescription">
      <defaultValue></defaultValue>
    </requiredProperty>
    <requiredProperty key="artifactName">
      <defaultValue>${artifactId}</defaultValue>
    </requiredProperty>
    <requiredProperty key="artifactIdNoSpecialCharacters">
      <defaultValue>${artifactId}</defaultValue>
    </requiredProperty>
    <requiredProperty key="organizationName">
      <defaultValue></defaultValue>
    </requiredProperty>
    <requiredProperty key="hasParentProject">
      <defaultValue>false</defaultValue>
    </requiredProperty>
    <requiredProperty key="hashSymbol">
      <defaultValue>#</defaultValue>
    </requiredProperty>
    <requiredProperty key="artifactIdShorthand">
      <defaultValue></defaultValue>
    </requiredProperty>
    <!-- The project's licence: we do not choose it for the customer. none writes no header and
         no LICENSE file; any other value stamps that licence's header into every generated
         source file and writes its LICENSE. Saved in the pom as kestros.hub.license. -->
    <requiredProperty key="license">
      <defaultValue>none</defaultValue>
      <validationRegex>^(none|GPL-3\.0|Apache-2\.0|MIT)$</validationRegex>
    </requiredProperty>
    <!-- No other Community Hub properties here: the archetype plugin treats an empty value as missing
         and refuses to generate, so a project without hub metadata could not be created. The
         root pom carries empty kestros.hub.* properties instead, and community-hub's build
         names each one that is still empty. -->
  </requiredProperties>

</archetype-descriptor>