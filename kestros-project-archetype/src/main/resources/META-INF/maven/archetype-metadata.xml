<archetype-descriptor name="single-project-archetype"
  xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype/1.0.0 http://maven.apache.org/xsd/archetype-1.0.0.xsd">

  <id>kestros-project-archetype</id>

  <allowPartial>true</allowPartial>

  <fileSets>
    <fileSet filtered="true" packaged="false">
      <directory/>
      <includes>
        <include>gitignore</include>
        <include>README.md</include>
        <include>pom.xml</include>
        <include>pom-with-modules.xml</include>
      </includes>
    </fileSet>

    <fileSet filtered="true" packaged="false">
      <directory>community-hub</directory>
      <includes>
        <include>pom.xml</include>
      </includes>
    </fileSet>

    <!-- Licence texts. archetype-post-generate.groovy copies the chosen one to LICENSE and
         deletes this directory. -->
    <fileSet filtered="false" packaged="false">
      <directory>licenses</directory>
      <includes>
        <include>*.txt</include>
      </includes>
    </fileSet>

    <!-- Unfiltered: Velocity would eat the script's ${} expressions. -->
    <fileSet filtered="false" packaged="false">
      <directory>community-hub/src/build</directory>
      <includes>
        <include>**/*</include>
      </includes>
    </fileSet>

