      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/cms2/fields/general/textfield",
      "label": "Title",
      "name": "sampleProperty",
      "autofocus": true
    },
    "style": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/cms2/fields/general/selectfield",
      "label": "Display Style",
