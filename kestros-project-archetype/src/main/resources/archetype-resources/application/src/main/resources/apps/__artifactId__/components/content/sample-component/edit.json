        "highlight": {
          "jcr:primaryType": "nt:unstructured",
          "text": "Highlight",
          "value": "highlight",
          "selected": false
        },
        "subtle": {
          "jcr:primaryType": "nt:unstructured",
          "text": "Subtle",
          "value": "subtle",
          "selected": false
        }
