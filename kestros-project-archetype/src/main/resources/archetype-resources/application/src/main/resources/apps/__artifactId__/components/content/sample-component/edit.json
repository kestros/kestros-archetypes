{
  "jcr:primaryType": "nt:unstructured",
  "sling:resourceType": "kestros/cms2/dialog",
  "content": {
    "jcr:primaryType": "nt:unstructured",
    "title": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/cms2/fields/general/textfield",
      "label": "Title",
      "name": "sampleProperty",
      "autofocus": true
    },
    "style": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/cms2/fields/general/selectfield",
      "label": "Display Style",
      "name": "displayStyle",
      "options": [
        { "value": "default", "text": "Default", "selected": true },
        { "value": "highlight", "text": "Highlight" },
        { "value": "subtle", "text": "Subtle" }
      ]
    },
    "show-icon": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "kestros/cms2/fields/general/checkbox",
      "label": "Show Icon",
      "name": "showIcon"
    }
  }
}
