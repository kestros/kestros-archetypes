#set($dollar = '$')
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.kestros.cms</groupId>
        <artifactId>kestros-site-parent</artifactId>
        <version>0.1.2</version>
        <relativePath/>
    </parent>

    <groupId>${groupId}</groupId>
    <artifactId>${artifactId}</artifactId>
    <version>${version}</version>
    <packaging>pom</packaging>

    <name>${artifactName}</name>
    <description>${artifactDescription}</description>
    <url></url>
    <inceptionYear></inceptionYear>

    <organization>
        <name>${organizationName}</name>
    </organization>
    <developers>
        <developer></developer>
    </developers>
    <licenses>
        <license></license>
    </licenses>
    <scm>
        <connection></connection>
        <developerConnection></developerConnection>
        <url></url>
    </scm>

    <properties>
        <!-- Community Hub metadata. The community-hub module writes these, with the project
             version, to META-INF/kestros/community-hub.json and fails its build when one is
             missing or malformed. Tags are comma-separated and need one type: tag; dependencies
             are whitespace-separated, each packageId:x.y.z or packageId:[x.y.z,x.y.z). -->
        <kestros.hub.id></kestros.hub.id>
        <kestros.hub.title></kestros.hub.title>
        <kestros.hub.description></kestros.hub.description>
        <kestros.hub.tags></kestros.hub.tags>
        <kestros.hub.dependencies></kestros.hub.dependencies>
        <!-- Chosen at generation: none, GPL-3.0, Apache-2.0 or MIT. -->
        <kestros.hub.license>${license}</kestros.hub.license>
    </properties>

    <modules>
        <module>api</module>
        <module>core</module>
        <module>application</module>
        <module>content</module>
        <module>community-hub</module>
    </modules>

</project>