<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- No parent, matching kestros-application-archetype and kestros-project-archetype, whose
         parent blocks are likewise commented out. This module previously declared
         kestros-archetypes:0.2.0-SNAPSHOT with relativePath ../pom.xml - but the root pom is
         version 0.9.0, so the relativePath never matched and Maven resolved that parent from the
         private Nexus instead. Three consequences, all removed by dropping it: the whole reactor
         gained a private-repository dependency, a SNAPSHOT parent made the module unreleasable,
         and the licence below was being inherited as GPL-v3.0 from a 2025 parent while this
         project is Apache-2.0. -->

    <groupId>io.kestros.cms</groupId>
    <artifactId>kestros-tutorial-application-archetype</artifactId>
    <version>0.9.0</version>

    <name>Kestros Tutorial Application Module Archetype</name>

    <description>Archetype for generating a guided tutorial project for Kestros.</description>

    <url>https://www.kestros.io</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <packaging>maven-archetype</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archetype.version>3.2.1</archetype.version>
    </properties>

    <!-- Test scope only. Nothing here reaches the generated project or the published archetype. -->
    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Declared here rather than inherited, now that this module has no parent - the same
             shape kestros-application-archetype uses. Without it the packaging above is unknown
             and the module cannot be read at all. -->
        <extensions>
            <extension>
                <groupId>org.apache.maven.archetype</groupId>
                <artifactId>archetype-packaging</artifactId>
                <version>${archetype.version}</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <artifactId>maven-archetype-plugin</artifactId>
                <version>${archetype.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- 11, not 1.11. There is no 1.11 and javac rejects it; the aggregator still
                         carries the wrong value because until now the archetype lifecycle ran no
                         compiler goal to read it. -->
                    <source>11</source>
                    <target>11</target>
                </configuration>
                <!-- The maven-archetype lifecycle binds no test goals at all, so unit tests need
                     both of these declared by hand or src/test/java is silently never built or
                     run. Same shape as kestros-project-archetype. -->
                <executions>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>