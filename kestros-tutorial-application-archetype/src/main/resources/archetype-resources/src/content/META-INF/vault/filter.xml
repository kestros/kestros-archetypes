<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">

    <!-- The tutorial's own components. Each carries a view per tutorial step, which is how the lesson
         works: switching the page's framework re-renders the same component with the next step's
         instructions in it. -->
    <filter root="/apps/${artifactId}"/>

    <!-- The three tutorial sites the learner actually opens. -->
    <filter root="/content/sites/${artifactId}-beginner-tutorial"/>
    <filter root="/content/sites/${artifactId}-intermediate-tutorial"/>
    <filter root="/content/sites/${artifactId}-advanced-tutorial"/>

    <!-- One UI framework per step. The learner switches between these from the editor, and the one
         they pick decides which view of the tutorial component resolves - so the page teaches view
         resolution by performing it.
         Note the first two are named "beginner-step", not "step": the previous filter listed
         tutorial-step-1-framework and tutorial-step-2-framework, which do not exist. -->
    <filter root="/etc/ui-frameworks/tutorial-beginner-step-1-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-beginner-step-2-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-3-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-4-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-5-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-6-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-7-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-8-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-9-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-10-framework"/>
    <filter root="/etc/ui-frameworks/tutorial-step-11-framework"/>

    <!-- Vendor libraries the step frameworks pull in, including a versioned one. -->
    <filter root="/etc/vendor-libraries/tutorial-step-2-basic-library"/>
    <filter root="/etc/vendor-libraries/tutorial-step-3-cards"/>
    <filter root="/etc/vendor-libraries/tutorial-step-4-versioned-library"/>

</workspaceFilter>
